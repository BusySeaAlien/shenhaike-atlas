---
import "../styles/global.css";
import "../styles/admin.css";

interface Props { title: string }
const { title } = Astro.props;
const admin = Astro.locals.admin;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Atlas Admin</title>
  </head>
  <body>
    <div class="admin-shell">
      <header class="admin-header">
        <a class="admin-brand" href="/guillaume/">ATLAS <span>/ ADMIN</span></a>
        <nav class="admin-nav" aria-label="后台导航">
          <a href="/guillaume/places/">Places</a>
          <a href="/guillaume/journeys/">Journeys</a>
          <a href="/guillaume/wishlist/">Wishlist</a>
          <a href="/guillaume/flights/">Flights</a>
          <a href="/guillaume/airports/">Airports</a>
          <a href="/guillaume/airlines/">Airlines</a>
          <a href="/guillaume/aircraft-types/">Aircraft Types</a>
          <a href="/" target="_blank">View site ↗</a>
        </nav>
      </header>
      <div class="admin-identity">{admin?.email}{admin?.local ? " · LOCAL DEV" : ""}</div>
      <main class="admin-main"><slot /></main>
    </div>
  </body>
</html>
