---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  bodyClass?: string;
  colorScheme?: "light" | "dark";
}

const {
  title = "Atlas — 深海客",
  description = "Personal Geographic Archive · 个人地理档案",
  canonicalPath = Astro.url.pathname,
  bodyClass,
  colorScheme = "light",
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content={colorScheme} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">跳到正文</a>
    <div class="page-shell">
      <header class="site-header">
        <div class="brand-lockup">
          <a class="wordmark" href="https://shenhaike.com">SHENHAIKE</a>
          <span aria-hidden="true">/</span>
          <a class="wordmark" href="/">ATLAS</a>
        </div>
        <nav aria-label="主导航">
          <a href="/map/">Map</a>
          <a href="/journeys/">Journeys</a>
          <a href="/timeline/">Timeline</a>
          <a href="/about/">About</a>
          <a href="https://shenhaike.com">Home</a>
        </nav>
      </header>
      <main id="content"><slot /></main>
      <footer>
        {Astro.slots.has("footer-content") ? <slot name="footer-content" /> : <>
          <span>31.2304° N · 121.4737° E</span>
          <span>Personal Geographic Archive</span>
        </>}
      </footer>
    </div>
  </body>
</html>
