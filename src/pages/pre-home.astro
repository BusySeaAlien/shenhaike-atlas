---
import DataFailure from "../components/DataFailure.astro";
import JourneyCard from "../components/JourneyCard.astro";
import PreHomeGlobe from "../components/PreHomeGlobe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDatabase } from "../lib/db/client";
import { getPreHomeData } from "../lib/db/public";
import { GLOBE_ATTRIBUTION } from "../lib/map/config";

let data: Awaited<ReturnType<typeof getPreHomeData>> | null = null;
try {
  data = await getPreHomeData(getDatabase());
} catch {
  Astro.response.status = 503;
}
---

<BaseLayout title="Atlas Globe — 深海客" description="在旋转的地球上浏览 Atlas 记录过的地点与旅程。" canonicalPath="/pre-home/" bodyClass="prehome-space" colorScheme="dark">
  {data ? <div class="prehome-page">
    <PreHomeGlobe points={data.mapPoints} routes={data.routes} />

    <section class="home-section" aria-labelledby="prehome-journeys-heading">
      <div class="section-heading"><div><p class="eyebrow">JOURNEYS / RECENT</p><h2 id="prehome-journeys-heading">Journeys</h2></div><a href="/journeys/">View all ↗</a></div>
      {data.journeys.length ? <div class="journey-grid">{data.journeys.slice(0, 3).map((journey, index) => <JourneyCard journey={journey} index={index} />)}</div> : <p class="archive-empty">No journeys yet.</p>}
    </section>

    <section class="home-section" aria-labelledby="prehome-places-heading">
      <div class="section-heading"><div><p class="eyebrow">PLACES / LAST VISITED</p><h2 id="prehome-places-heading">Recent Places</h2></div><a href="/map/">Explore map ↗</a></div>
      {data.recentPlaces.length ? <ol class="place-list">{data.recentPlaces.map((place, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><a href={`/places/${place.slug}/`}>{place.nameZh || place.name}</a>{place.nameZh && <small>{place.name}</small>}</div><p>{[place.city, place.region, place.country].filter(Boolean).join(" · ")}</p><time datetime={place.lastVisitedAt}>{place.lastVisitedAt}</time></li>)}</ol> : <p class="archive-empty">No visited places yet.</p>}
    </section>

    <section class="stats" aria-label="Archive statistics">
      <div><strong>{data.stats.places}</strong><span>Places</span></div>
      <div><strong>{data.stats.journeys}</strong><span>Journeys</span></div>
      <div><strong>{data.stats.regions}</strong><span>Regions</span></div>
    </section>
  </div> : <DataFailure />}
  <span class="footer-attribution" slot="footer-content">
    <a href={GLOBE_ATTRIBUTION.href}>{GLOBE_ATTRIBUTION.label}</a><span> · </span><a href={GLOBE_ATTRIBUTION.libraryHref}>{GLOBE_ATTRIBUTION.libraryLabel}</a>
  </span>
</BaseLayout>
