---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getDatabase } from "../../lib/db/client";
import { listJourneys } from "../../lib/db/journeys";
import { listPlaces } from "../../lib/db/places";
import { listWishlistItems } from "../../lib/db/wishlist";
import { listAirports } from "../../lib/db/airports";
import { listAirlines } from "../../lib/db/airlines";
import { listAircraftTypes } from "../../lib/db/aircraft-types";
import { listFlights } from "../../lib/db/flights";
import { formatFlightDuration } from "../../lib/flight-math";

const db = getDatabase();
const requestedView = Astro.url.searchParams.get("view");
const recordViews = ["journeys", "places", "wishlist", "airports", "airlines", "aircraft-types", "flights"] as const;
type RecordView = typeof recordViews[number];
const view: RecordView = recordViews.includes(requestedView as RecordView) ? requestedView as RecordView : "journeys";
const journeySort = Astro.url.searchParams.get("sort") === "asc" ? "asc" : "desc";
const counts = await db.prepare(`
  SELECT
    (SELECT COUNT(*) FROM atlas_places) AS places,
    (SELECT COUNT(*) FROM atlas_journeys) AS journeys,
    (SELECT COUNT(*) FROM atlas_visits) AS visits,
    (SELECT COUNT(*) FROM atlas_wishlist_items) AS wishlist,
    (SELECT COUNT(*) FROM atlas_flights) AS flights,
    (SELECT COUNT(*) FROM atlas_airports) AS airports,
    (SELECT COUNT(*) FROM atlas_airlines) AS airlines,
    (SELECT COUNT(*) FROM atlas_aircraft_types) AS aircraft_types
`).first<{ places: number; journeys: number; visits: number; wishlist: number; flights: number; airports: number; airlines: number; aircraft_types: number }>();
const journeys = view === "journeys"
  ? (await listJourneys(db)).sort((a, b) => {
      const comparison = a.startDate.localeCompare(b.startDate);
      return journeySort === "asc" ? comparison : -comparison;
    })
  : [];
const places = view === "places"
  ? (await listPlaces(db)).sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
  : [];
const wishlist = view === "wishlist" ? await listWishlistItems(db) : [];
const airports = view === "airports" ? await listAirports(db) : [];
const airlines = view === "airlines" ? await listAirlines(db) : [];
const aircraftTypes = view === "aircraft-types" ? await listAircraftTypes(db) : [];
const flights = view === "flights" ? await listFlights(db) : [];
---

<AdminLayout title="Dashboard">
  <div class="admin-heading"><div><p class="eyebrow">PRIVATE WORKSPACE</p><h1>Dashboard</h1></div></div>
  <dl class="dashboard-grid">
    <div class="metric"><dt>Places</dt><dd>{counts?.places ?? 0}</dd></div>
    <div class="metric"><dt>Journeys</dt><dd>{counts?.journeys ?? 0}</dd></div>
    <div class="metric"><dt>Visits</dt><dd>{counts?.visits ?? 0}</dd></div>
    <div class="metric"><dt>Wishlist</dt><dd>{counts?.wishlist ?? 0}</dd></div>
    <div class="metric"><dt>Flights</dt><dd>{counts?.flights ?? 0}</dd></div>
    <div class="metric"><dt>Airports</dt><dd>{counts?.airports ?? 0}</dd></div>
    <div class="metric"><dt>Airlines</dt><dd>{counts?.airlines ?? 0}</dd></div>
    <div class="metric"><dt>Aircraft Types</dt><dd>{counts?.aircraft_types ?? 0}</dd></div>
  </dl>
  <div class="quick-actions"><a class="button" href="/guillaume/places/new/">+ New Place</a><a class="button secondary" href="/guillaume/journeys/new/">+ New Journey</a><a class="button secondary" href="/guillaume/wishlist/new/">+ New Wishlist Item</a><a class="button secondary" href="/guillaume/flights/new/">+ New Flight</a><a class="button secondary" href="/guillaume/airports/new/">+ New Airport</a><a class="button secondary" href="/guillaume/airlines/new/">+ New Airline</a><a class="button secondary" href="/guillaume/aircraft-types/new/">+ New Aircraft Type</a></div>
  <section class="admin-section">
    <nav class="record-switcher" aria-label="Choose records to view">
      <a class:list={["button", { secondary: view !== "journeys" }]} href="/guillaume/?view=journeys" aria-current={view === "journeys" ? "page" : undefined}>Journeys</a>
      <a class:list={["button", { secondary: view !== "places" }]} href="/guillaume/?view=places" aria-current={view === "places" ? "page" : undefined}>Places</a>
      <a class:list={["button", { secondary: view !== "wishlist" }]} href="/guillaume/?view=wishlist" aria-current={view === "wishlist" ? "page" : undefined}>Wishlist</a>
      <a class:list={["button", { secondary: view !== "airports" }]} href="/guillaume/?view=airports" aria-current={view === "airports" ? "page" : undefined}>Airports</a>
      <a class:list={["button", { secondary: view !== "airlines" }]} href="/guillaume/?view=airlines" aria-current={view === "airlines" ? "page" : undefined}>Airlines</a>
      <a class:list={["button", { secondary: view !== "aircraft-types" }]} href="/guillaume/?view=aircraft-types" aria-current={view === "aircraft-types" ? "page" : undefined}>Aircraft Types</a>
      <a class:list={["button", { secondary: view !== "flights" }]} href="/guillaume/?view=flights" aria-current={view === "flights" ? "page" : undefined}>Flights</a>
      {view === "journeys" && (
        <a class="button secondary sort-toggle" href={`/guillaume/?view=journeys&sort=${journeySort === "desc" ? "asc" : "desc"}`}>
          {journeySort === "desc" ? "Dates: newest first ↓" : "Dates: oldest first ↑"}
        </a>
      )}
    </nav>
    {view === "journeys" ? (
      journeys.length ? <table class="data-table"><thead><tr><th>Journey</th><th>Dates</th><th>Updated</th></tr></thead><tbody>{journeys.map((journey) => <tr><td><a href={`/guillaume/journeys/${journey.id}/`}>{journey.nameZh || journey.name}</a><br /><small>{journey.slug}</small></td><td>{journey.startDate} — {journey.endDate}</td><td>{journey.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No journeys yet.</p>
    ) : view === "places" ? (
      places.length ? <table class="data-table"><thead><tr><th>Place</th><th>Region</th><th>Coordinates</th><th>Updated</th></tr></thead><tbody>{places.map((place) => <tr><td><a href={`/guillaume/places/${place.id}/`}>{place.nameZh || place.name}</a><br /><small>{place.slug}</small></td><td>{[place.city, place.region, place.country].filter(Boolean).join(" · ")}</td><td>{place.latitude.toFixed(4)}, {place.longitude.toFixed(4)}</td><td>{place.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No places yet.</p>
    ) : view === "wishlist" ? (
      wishlist.length ? <table class="data-table"><thead><tr><th>Wishlist item</th><th>Region</th><th>Coordinates</th><th>Updated</th></tr></thead><tbody>{wishlist.map((item) => <tr><td><a href={`/guillaume/wishlist/${item.id}/`}>{item.nameZh || item.name}</a>{item.nameZh && <><br /><small>{item.name}</small></>}</td><td>{[item.city, item.region, item.country].filter(Boolean).join(" · ")}</td><td>{item.latitude.toFixed(4)}, {item.longitude.toFixed(4)}</td><td>{item.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No wishlist items yet.</p>
    ) : view === "airports" ? (
      airports.length ? <table class="data-table"><thead><tr><th>IATA</th><th>Airport</th><th>Location</th><th>Coordinates</th><th>Updated</th></tr></thead><tbody>{airports.map((airport) => <tr><td><a href={`/guillaume/airports/${airport.id}/`}>{airport.iataCode}</a><br /><small>{airport.icaoCode ?? "—"}</small></td><td>{airport.nameZh || airport.name}{airport.nameZh && <><br /><small>{airport.name}</small></>}</td><td>{[airport.city, airport.region, airport.country].filter(Boolean).join(" · ")}</td><td>{airport.latitude.toFixed(4)}, {airport.longitude.toFixed(4)}</td><td>{airport.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No airports yet.</p>
    ) : view === "airlines" ? (
      airlines.length ? <table class="data-table"><thead><tr><th>IATA</th><th>Airline</th><th>Country</th><th>Callsign</th><th>Updated</th></tr></thead><tbody>{airlines.map((airline) => <tr><td><a href={`/guillaume/airlines/${airline.id}/`}>{airline.iataCode}</a><br /><small>{airline.icaoCode ?? "—"}</small></td><td>{airline.nameZh || airline.name}{airline.nameZh && <><br /><small>{airline.name}</small></>}</td><td>{airline.country}</td><td>{airline.callsign ?? "—"}</td><td>{airline.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No airlines yet.</p>
    ) : view === "aircraft-types" ? (
      aircraftTypes.length ? <table class="data-table"><thead><tr><th>ICAO</th><th>Aircraft type</th><th>Manufacturer</th><th>Updated</th></tr></thead><tbody>{aircraftTypes.map((type) => <tr><td><a href={`/guillaume/aircraft-types/${type.id}/`}>{type.icaoCode}</a></td><td>{type.modelZh || type.model}{type.modelZh && <><br /><small>{type.model}</small></>}</td><td>{type.manufacturer}</td><td>{type.updatedAt}</td></tr>)}</tbody></table> : <p class="empty-admin">No aircraft types yet.</p>
    ) : (
      flights.length ? <table class="data-table"><thead><tr><th>Flight</th><th>Date</th><th>Route</th><th>Type</th><th>Distance</th><th>Time</th><th>Airline</th></tr></thead><tbody>{flights.map((flight) => <tr><td><a href={`/guillaume/flights/${flight.id}/`}>{flight.displayNumber}</a>{flight.journeyName && <><br /><small>{flight.journeyNameZh || flight.journeyName}</small></>}</td><td>{flight.flightDate}</td><td>{flight.departureLabel} → {flight.arrivalLabel}</td><td>{flight.isDomestic ? "Domestic" : "International"}</td><td>{Math.round(flight.routeDistanceKm)} km</td><td>{formatFlightDuration(flight.estimatedHours)}</td><td>{flight.airlineNameZh || flight.airlineName}</td></tr>)}</tbody></table> : <p class="empty-admin">No flights yet.</p>
    )}
  </section>
</AdminLayout>
