---
const target = new URL("/", Astro.url);
const year = Astro.url.searchParams.get("year");
const journey = Astro.url.searchParams.get("journey");
if (journey) {
  target.searchParams.set("view", "journey");
  target.searchParams.set("journey", journey);
} else if (year) {
  target.searchParams.set("year", year);
}
target.hash = "globe";
return Astro.redirect(`${target.pathname}${target.search}${target.hash}`, 301);
