---
import "maplibre-gl/dist/maplibre-gl.css";
import type { MapJourneyRoute, MapPoint, WishlistPoint } from "../types/domain";
import { isChinaCountry } from "../lib/map/globe";
import { DEFAULT_SCOPE, DEFAULT_VIEW, captionFor } from "../lib/map/globe-state";

interface Props {
  points: MapPoint[];
  routes: MapJourneyRoute[];
  wishlist: WishlistPoint[];
}

const { points, routes, wishlist } = Astro.props;
const years = [...new Set(points.flatMap((point) => point.years))].sort((a, b) => b.localeCompare(a));
const payload = JSON.stringify({ points, routes, wishlist }).replaceAll("<", "\\u003c");
---

<section class="prehome-globe" id="globe" data-prehome-globe>
  <header class="prehome-globe-heading">
    <div>
      <p class="eyebrow">ATLAS / THE WORLD IN MEMORY</p>
      <h1>Places,<br />in orbit.</h1>
    </div>
    <p>去过的地点散落在地球上。选择一段旅程，查看由访问顺序连接起来的路径。</p>
  </header>

  {(points.length || wishlist.length) ? (
    <div class="globe-experience" data-globe-entry>
      {/* Defaults come from globe-state.ts rather than being written out here,
          so the markup cannot drift from DEFAULT_SCOPE / DEFAULT_VIEW and flash
          the wrong state before the script runs. Scope on the left, View on the
          right; the View order puts the default first. */}
      <div class="globe-toolbar" aria-label="Globe controls">
        <div class="globe-mode" role="group" aria-label="Map extent">
          <button type="button" class:list={{ "is-active": DEFAULT_SCOPE === "world" }} aria-pressed={DEFAULT_SCOPE === "world"} data-globe-scope="world">World</button>
          <button type="button" class:list={{ "is-active": DEFAULT_SCOPE === "china" }} aria-pressed={DEFAULT_SCOPE === "china"} data-globe-scope="china">China</button>
        </div>
        <div class="globe-mode" role="group" aria-label="Map view">
          <button type="button" class:list={{ "is-active": DEFAULT_VIEW === "footprint" }} aria-pressed={DEFAULT_VIEW === "footprint"} data-globe-view="footprint">Footprint</button>
          <button type="button" class:list={{ "is-active": DEFAULT_VIEW === "journey" }} aria-pressed={DEFAULT_VIEW === "journey"} data-globe-view="journey">Journey</button>
        </div>
        <div class="globe-mode" role="group" aria-label="Place display">
          <button type="button" aria-pressed="false" data-globe-clusters>Cluster places</button>
        </div>
        {wishlist.length > 0 && (
          <div class="globe-mode" role="group" aria-label="Overlays">
            <button type="button" aria-pressed="false" data-globe-wishlist>Wishlist</button>
          </div>
        )}
        <label data-year-selector hidden={DEFAULT_VIEW !== "footprint"}>
          <span>Year</span>
          <select data-globe-year aria-label="Filter footprint by visit year">
            <option value="">All time</option>
            {years.map((year) => <option value={year}>{year}</option>)}
          </select>
        </label>
        <label data-journey-selector hidden={DEFAULT_VIEW !== "journey"}>
          <span>Journey</span>
          <select data-globe-journey aria-label="Show a journey visit sequence">
            <option value="">Places only</option>
            {routes.map((route) => (
              <option value={route.slug} data-china={route.stops.some((stop) => isChinaCountry(stop.country)) ? "true" : "false"}>
                {route.nameZh || route.name}
              </option>
            ))}
          </select>
        </label>
        <p data-globe-caption>{captionFor(DEFAULT_VIEW)}</p>
      </div>

      <div class="globe-stage">
        <div class="globe-canvas" data-globe-canvas role="region" aria-label="Rotating globe of visited places" tabindex="0"></div>
        <p class="map-runtime-status" data-globe-status aria-live="polite">Loading the globe. Every place remains available below.</p>
        <div class="globe-footprint-tip" data-globe-footprint-tip hidden aria-hidden="true"></div>
        <div class="globe-orbit-label" aria-hidden="true"><span>E</span><i></i><span>W</span></div>
      </div>

      <aside class="globe-selection" data-globe-selection hidden aria-live="polite">
        <div><p class="eyebrow">SELECTED PLACE</p><h2 data-globe-place-name></h2></div>
        <p data-globe-place-location></p>
        <a data-globe-place-link>View place ↗</a>
      </aside>

      <section class="globe-results" aria-labelledby="globe-results-title">
        <header>
          <div><p class="eyebrow">FILTERED PLACES</p><h2 id="globe-results-title" data-globe-results-title>{points.length} places · All time</h2></div>
          <button type="button" data-globe-results-toggle hidden>View all</button>
        </header>
        <ol data-globe-results-list>
          {points.map((point, index) => (
            <li data-globe-result={point.id} hidden={index >= 8}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div><button type="button" data-globe-result-select={point.id}>{point.name}</button>{point.name !== point.nameEn && <small>{point.nameEn}</small>}</div>
              <p>{point.location}</p>
              <time datetime={point.lastVisitedAt}>{point.lastVisitedAt}</time>
              <a href={point.href} aria-label={`View ${point.name}`}>↗</a>
            </li>
          ))}
        </ol>
        <p data-globe-results-empty hidden>No places match this filter.</p>
      </section>

      <noscript>
        <div class="globe-noscript">
          <p>JavaScript is unavailable. Browse the mapped places directly:</p>
          <ul>{points.map((point) => <li><a href={point.href}>{point.name}</a></li>)}</ul>
        </div>
      </noscript>
    </div>
  ) : (
    <div class="map-empty"><p>No visited places yet.</p><span>The globe will appear after the first visit is recorded.</span></div>
  )}
  <script type="application/json" data-globe-payload set:html={payload} is:inline />
</section>

<script>
  import * as maplibregl from "maplibre-gl";
  import type { GeoJSONSource, MapEventType, MapLayerMouseEvent } from "maplibre-gl";
  import { ensureChinaBoundaryLoaded, hideChinaBoundary, showChinaBoundary } from "../lib/map/boundaries/china";
  import {
    ensureChinaAdministrativeLoaded,
    hideChinaAdministrative,
    showChinaAdministrative,
    applyChinaVisitedState,
    bindChinaHover,
  } from "../lib/map/administrative/china";
  import { getVisitedChinaRegions, getVisitedCountries, countByCode } from "../lib/map/administrative/footprint";
  import type { FootprintHover } from "../lib/map/administrative/layers";
  import {
    applyWorldVisitedState,
    bindWorldHover,
    ensureWorldAdministrativeLoaded,
    hideWorldAdministrative,
    showWorldAdministrative,
  } from "../lib/map/administrative/world";
  import { CLUSTER_RADIUS_EXPRESSION, GLOBE_STYLE, PLACE_CLUSTER_OPTIONS, WISHLIST_POINT_COLOR } from "../lib/map/config";
  import { filterMapPoints } from "../lib/map/points";
  import {
    CHINA_OVERVIEW_BOUNDS,
    CHINA_OVERVIEW_PADDING,
    GLOBE_ROTATION,
    WORLD_CAMERA,
    journeyLineGeoJson,
    journeyCameraTarget,
    journeyStopsGeoJson,
    nightLightsGeoJson,
    pointsForMode,
    rotationAllowedAtZoom,
    routeAvailableInMode,
    wishlistPointsGeoJson,
    type ScopeMode,
    type NightLightPoint,
  } from "../lib/map/globe";
  import { createNightHemisphereLayer } from "../lib/map/night-layer";
  import {
    DEFAULT_SCOPE,
    DEFAULT_VIEW,
    captionFor,
    visibilityPlan,
    type ViewMode,
  } from "../lib/map/globe-state";
  import type { MapJourneyRoute, MapPoint, WishlistPoint } from "../types/domain";

  function initializeGlobe(root: HTMLElement) {
    if (root.dataset.enhanced) return;
    root.dataset.enhanced = "true";
    const canvas = root.querySelector<HTMLElement>("[data-globe-canvas]");
    const payload = root.querySelector<HTMLScriptElement>("[data-globe-payload]");
    const status = root.querySelector<HTMLElement>("[data-globe-status]");
    if (!canvas || !payload) return;

    let points: MapPoint[] = [];
    let routes: MapJourneyRoute[] = [];
    let wishlist: WishlistPoint[] = [];
    try {
      ({ points, routes, wishlist } = JSON.parse(payload.textContent || "{}") as { points: MapPoint[]; routes: MapJourneyRoute[]; wishlist: WishlistPoint[] });
    } catch {
      if (status) status.textContent = "Globe data unavailable. Use the archive links below.";
      return;
    }

    const pointById = new Map(points.map((point) => [point.id, point]));
    const routeBySlug = new Map(routes.map((route) => [route.slug, route]));
    const scopeButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-globe-scope]")];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-globe-view]")];
    const clusterButton = root.querySelector<HTMLButtonElement>("[data-globe-clusters]");
    const wishlistButton = root.querySelector<HTMLButtonElement>("[data-globe-wishlist]");
    const yearSelector = root.querySelector<HTMLElement>("[data-year-selector]");
    const journeySelector = root.querySelector<HTMLElement>("[data-journey-selector]");
    const caption = root.querySelector<HTMLElement>("[data-globe-caption]");
    const footprintTip = root.querySelector<HTMLElement>("[data-globe-footprint-tip]");
    const yearSelect = root.querySelector<HTMLElement>("[data-globe-year]") as HTMLSelectElement | null;
    const journeySelect = root.querySelector<HTMLElement>("[data-globe-journey]") as HTMLSelectElement | null;
    const selection = root.querySelector<HTMLElement>("[data-globe-selection]");
    const resultsTitle = root.querySelector<HTMLElement>("[data-globe-results-title]");
    const resultsToggle = root.querySelector<HTMLButtonElement>("[data-globe-results-toggle]");
    const resultsEmpty = root.querySelector<HTMLElement>("[data-globe-results-empty]");
    const resultItems = new Map(
      [...root.querySelectorAll<HTMLElement>("[data-globe-result]")].map((item) => [item.dataset.globeResult!, item]),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const urlState = new URLSearchParams(window.location.search);
    let scopeMode: ScopeMode = urlState.get("scope") === "china" ? "china" : DEFAULT_SCOPE;
    let viewMode: ViewMode = urlState.get("view") === "journey" ? "journey" : DEFAULT_VIEW;
    let clusteringEnabled = urlState.get("cluster") === "1";
    let wishlistEnabled = urlState.get("wishlist") === "1";
    // With no visited places the results list has nothing to show; say where
    // the wishlist points went instead (Wishlist handoff §7.6).
    if (resultsEmpty && points.length === 0 && wishlist.length > 0) {
      resultsEmpty.textContent = "No visited places yet. Wishlist points are shown on the globe.";
    }
    let selectedYear = points.some((point) => point.years.includes(urlState.get("year") ?? "")) ? urlState.get("year")! : "";
    let selectedJourney = routeBySlug.has(urlState.get("journey") ?? "") ? urlState.get("journey")! : "";
    if (yearSelect) yearSelect.value = selectedYear;
    if (journeySelect) journeySelect.value = selectedJourney;
    let resultsExpanded = false;
    let clusterResultIds: Set<string> | null = null;
    let stateRevision = 0;
    let popup: maplibregl.Popup | null = null;
    let mapVisible = true;
    let frameId = 0;
    let restartTimer = 0;
    let lastFrame = 0;
    let nightLightPoints: NightLightPoint[] = [];

    const pointGeoJson = (items: MapPoint[]) => ({
      type: "FeatureCollection" as const,
      features: items.map((point) => ({
        type: "Feature" as const,
        id: point.id,
        properties: { id: point.id },
        geometry: { type: "Point" as const, coordinates: [point.longitude, point.latitude] as [number, number] },
      })),
    });

    let map: maplibregl.Map;

    const canRotate = () => scopeMode === "world"
      && !(viewMode === "journey" && selectedJourney)
      && rotationAllowedAtZoom(map.getZoom())
      && !reducedMotion.matches
      && mapVisible
      && !document.hidden;
    const stopRotation = () => {
      if (frameId) window.cancelAnimationFrame(frameId);
      frameId = 0;
      lastFrame = 0;
    };
    const rotate = (time: number) => {
      frameId = 0;
      if (!canRotate()) return;
      if (lastFrame && !map.isMoving()) {
        const elapsed = Math.min(time - lastFrame, 50);
        const center = map.getCenter();
        map.setCenter([center.lng + GLOBE_ROTATION.degreesPerSecond * elapsed / 1000, center.lat]);
      }
      lastFrame = time;
      frameId = window.requestAnimationFrame(rotate);
    };
    const startRotation = () => {
      if (!frameId && canRotate()) frameId = window.requestAnimationFrame(rotate);
    };
    const pauseRotation = (delay: number = GLOBE_ROTATION.idleDelay) => {
      stopRotation();
      window.clearTimeout(restartTimer);
      restartTimer = window.setTimeout(startRotation, delay);
    };

    const closePopup = () => {
      popup?.remove();
      popup = null;
    };

    // Footprint hover readout (§58/§59). Counts come from the same place codes
    // the fill uses, so the number and the colour can never disagree.
    let worldPlaceCounts = countByCode(points, (point) => point.sovereignCountryCode);
    let chinaPlaceCounts = countByCode(points, (point) => point.admin1Code);
    let worldHoverBound = false;
    let chinaHoverBound = false;

    const showFootprintTip = (hover: FootprintHover | null, counts: Map<string, number>) => {
      if (!footprintTip) return;
      if (!hover?.name) {
        footprintTip.hidden = true;
        return;
      }
      const count = counts.get(hover.code) ?? 0;
      footprintTip.textContent = count > 0
        ? `${hover.name} · ${count} ${count === 1 ? "place" : "places"}`
        : `${hover.name} · Not visited`;
      footprintTip.style.left = `${hover.x}px`;
      footprintTip.style.top = `${hover.y}px`;
      footprintTip.hidden = false;
    };

    const hideFootprintTip = () => {
      if (footprintTip) footprintTip.hidden = true;
    };
    const showPlace = (point: MapPoint) => {
      closePopup();
      if (selection) {
        selection.hidden = false;
        selection.querySelector<HTMLElement>("[data-globe-place-name]")!.textContent = point.name;
        selection.querySelector<HTMLElement>("[data-globe-place-location]")!.textContent = point.location;
        const link = selection.querySelector<HTMLAnchorElement>("[data-globe-place-link]")!;
        link.href = point.href;
        link.setAttribute("aria-label", `View ${point.name}`);
      }
      const content = document.createElement("div");
      const title = document.createElement("strong");
      const link = document.createElement("a");
      title.textContent = point.name;
      link.href = point.href;
      link.textContent = "View place ↗";
      content.appendChild(title);
      content.appendChild(link);
      popup = new maplibregl.Popup({ closeButton: false, offset: 14 })
        .setLngLat([point.longitude, point.latitude])
        .setDOMContent(content)
        .addTo(map);
    };

    const filteredPoints = () => pointsForMode(
      filterMapPoints(points, viewMode === "footprint"
        ? { year: selectedYear || undefined }
        : { journey: selectedJourney || undefined }),
      scopeMode,
    );

    const updateResults = (visible: MapPoint[]) => {
      const listed = clusterResultIds
        ? visible.filter((point) => clusterResultIds?.has(point.id))
        : visible;
      const label = clusterResultIds
        ? "Selected cluster"
        : viewMode === "footprint"
          ? selectedYear || "All time"
          : routeBySlug.get(selectedJourney)?.nameZh || routeBySlug.get(selectedJourney)?.name || "All journeys";
      if (resultsTitle) resultsTitle.textContent = `${listed.length} ${listed.length === 1 ? "place" : "places"} · ${label}`;
      if (resultsEmpty) resultsEmpty.hidden = listed.length > 0;
      const listedIds = new Set(listed.map((point) => point.id));
      let position = 0;
      resultItems.forEach((item, id) => {
        const matches = listedIds.has(id);
        const shown = matches && (resultsExpanded || position < 8);
        item.hidden = !shown;
        if (matches) {
          position += 1;
          const number = item.querySelector<HTMLElement>(":scope > span");
          if (number) number.textContent = String(position).padStart(2, "0");
        }
      });
      if (resultsToggle) {
        resultsToggle.hidden = listed.length <= 8;
        resultsToggle.textContent = resultsExpanded ? "Show less" : `View all ${listed.length}`;
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-globe-result-select]").forEach((button) => {
      button.addEventListener("click", () => {
        const point = pointById.get(button.dataset.globeResultSelect ?? "");
        if (!point) return;
        showPlace(point);
        map.easeTo({
          center: [point.longitude, point.latitude],
          zoom: Math.max(map.getZoom(), 6),
          duration: reducedMotion.matches ? 0 : 650,
        });
      });
    });

    resultsToggle?.addEventListener("click", () => {
      resultsExpanded = !resultsExpanded;
      updateResults(filteredPoints());
    });

    const updateJourney = () => {
      const route = routeBySlug.get(selectedJourney);
      (map.getSource("journey-route") as GeoJSONSource | undefined)?.setData(journeyLineGeoJson(route, scopeMode));
      (map.getSource("journey-stops") as GeoJSONSource | undefined)?.setData(journeyStopsGeoJson(route, scopeMode));
    };

    const updateJourneyOptions = () => {
      if (!journeySelect) return;
      for (const option of [...journeySelect.options]) {
        if (!option.value) continue;
        const route = routeBySlug.get(option.value);
        option.hidden = !route || !routeAvailableInMode(route, scopeMode);
        option.disabled = option.hidden;
      }
      const selectedRoute = routeBySlug.get(selectedJourney);
      if (selectedRoute && !routeAvailableInMode(selectedRoute, scopeMode)) {
        selectedJourney = "";
        journeySelect.value = "";
      }
    };

    /** Journey layers follow View only, never Scope (§7). */
    const setJourneyLayersVisible = (visible: boolean) => {
      for (const layerId of ["journey-route", "journey-stops"]) {
        if (map.getLayer(layerId)) {
          map.setLayoutProperty(layerId, "visibility", visible ? "visible" : "none");
        }
      }
    };

    /** Wishlist is an independent overlay toggle, like clustering (handoff §7.1). */
    const setWishlistLayersVisible = (visible: boolean) => {
      const layerId = "wishlist-points";
      if (map.getLayer(layerId)) {
        map.setLayoutProperty(layerId, "visibility", visible ? "visible" : "none");
      }
    };

    /**
     * The single place Scope and View become map state (§53/§54).
     *
     * Both switches route through here so a new dimension cannot be wired into
     * one button handler and forgotten in another. Everything it decides comes
     * from `visibilityPlan`, which is unit-tested without a map.
     */
    const applyMapState = (animate = true) => {
      const revision = ++stateRevision;
      const plan = visibilityPlan(scopeMode, viewMode);
      const duration = animate && !reducedMotion.matches ? 950 : 0;
      updateJourneyOptions();
      const visiblePoints = filteredPoints();
      clusterResultIds = null;
      resultsExpanded = false;
      worldPlaceCounts = countByCode(visiblePoints, (point) => point.sovereignCountryCode);
      chinaPlaceCounts = countByCode(visiblePoints, (point) => point.admin1Code);

      for (const [buttons, key, value] of [
        [scopeButtons, "globeScope", scopeMode],
        [viewButtons, "globeView", viewMode],
      ] as const) {
        for (const button of buttons) {
          const active = button.dataset[key] === value;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        }
      }
      clusterButton?.classList.toggle("is-active", clusteringEnabled);
      clusterButton?.setAttribute("aria-pressed", String(clusteringEnabled));
      wishlistButton?.classList.toggle("is-active", wishlistEnabled);
      wishlistButton?.setAttribute("aria-pressed", String(wishlistEnabled));

      if (yearSelector) yearSelector.hidden = viewMode !== "footprint";
      if (journeySelector) journeySelector.hidden = !plan.journeySelector;
      if (caption) caption.textContent = captionFor(viewMode);
      setJourneyLayersVisible(plan.journeyLayers);
      (map.getSource("globe-wishlist") as GeoJSONSource | undefined)
        ?.setData(wishlistPointsGeoJson(wishlist, scopeMode));
      setWishlistLayersVisible(wishlistEnabled);

      closePopup();
      if (selection) selection.hidden = true;
      (map.getSource("globe-places") as GeoJSONSource | undefined)
        ?.setData(pointGeoJson(visiblePoints));
      updateJourney();
      updateResults(visiblePoints);
      if (status) status.textContent = `${visiblePoints.length} filtered places shown.`;
      const nextUrl = new URL(window.location.href);
      for (const key of ["scope", "view", "year", "journey", "cluster", "wishlist"]) nextUrl.searchParams.delete(key);
      if (scopeMode !== DEFAULT_SCOPE) nextUrl.searchParams.set("scope", scopeMode);
      if (viewMode !== DEFAULT_VIEW) nextUrl.searchParams.set("view", viewMode);
      if (viewMode === "footprint" && selectedYear) nextUrl.searchParams.set("year", selectedYear);
      if (viewMode === "journey" && selectedJourney) nextUrl.searchParams.set("journey", selectedJourney);
      if (clusteringEnabled) nextUrl.searchParams.set("cluster", "1");
      if (wishlistEnabled) nextUrl.searchParams.set("wishlist", "1");
      window.history.replaceState(null, "", `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
      pauseRotation();

      // Administrative fill. Each scope loads its own data the first time
      // Footprint is opened in that scope, and never refetches afterwards
      // (§65/§66/§67).
      if (plan.worldAdmin) {
        void ensureWorldAdministrativeLoaded(map)
          .then(() => {
            // Hover can only bind once the layer exists; MapLibre throws on an
            // unknown layer id, so this cannot move to the load handler.
            if (!worldHoverBound) {
              bindWorldHover(map, (hover) => showFootprintTip(hover, worldPlaceCounts));
              worldHoverBound = true;
            }
            // Scope or view may have moved on while the chunks loaded.
            if (revision !== stateRevision || !visibilityPlan(scopeMode, viewMode).worldAdmin) return;
            applyWorldVisitedState(map, getVisitedCountries(visiblePoints));
            showWorldAdministrative(map);
          })
          .catch((error) => console.warn("Atlas world footprint unavailable", error));
      } else {
        hideWorldAdministrative(map);
      }

      if (plan.chinaAdmin) {
        void ensureChinaAdministrativeLoaded(map)
          .then(() => {
            if (!chinaHoverBound) {
              bindChinaHover(map, (hover) => showFootprintTip(hover, chinaPlaceCounts));
              chinaHoverBound = true;
            }
            if (revision !== stateRevision || !visibilityPlan(scopeMode, viewMode).chinaAdmin) return;
            applyChinaVisitedState(map, getVisitedChinaRegions(visiblePoints));
            showChinaAdministrative(map);
          })
          .catch((error) => console.warn("Atlas China footprint unavailable", error));
      } else {
        hideChinaAdministrative(map);
      }

      // Only clear the readout when Footprint as a whole is left, so switching
      // scope inside Footprint does not flash the tooltip away.
      if (!plan.worldAdmin && !plan.chinaAdmin) hideFootprintTip();

      if (plan.chinaAuthority) {
        void ensureChinaBoundaryLoaded(map)
          .then(() => {
            // Scope may have flipped back while the boundary chunks loaded.
            if (revision === stateRevision && visibilityPlan(scopeMode, viewMode).chinaAuthority) showChinaBoundary(map);
          })
          .catch((error) => console.warn("Atlas China boundary unavailable", error));
      } else {
        hideChinaBoundary(map);
      }

      const journeyCamera = viewMode === "journey"
        ? journeyCameraTarget(routeBySlug.get(selectedJourney), scopeMode)
        : null;
      if (journeyCamera?.kind === "center") {
        map.easeTo({ center: journeyCamera.center, zoom: 5, bearing: 0, pitch: 0, duration });
      } else if (journeyCamera?.kind === "bounds") {
        map.fitBounds(journeyCamera.bounds, {
          padding: { top: 56, right: 72, bottom: 56, left: 72 },
          maxZoom: 5,
          bearing: 0,
          pitch: 0,
          duration,
        });
      } else if (scopeMode === "china") {
        map.fitBounds(CHINA_OVERVIEW_BOUNDS, { padding: CHINA_OVERVIEW_PADDING, bearing: 0, pitch: 0, duration });
      } else {
        map.easeTo({ ...WORLD_CAMERA, bearing: 0, pitch: 0, duration });
      }
    };

    try {
      map = new maplibregl.Map({
        container: canvas,
        style: GLOBE_STYLE,
        center: WORLD_CAMERA.center,
        zoom: WORLD_CAMERA.zoom,
        minZoom: WORLD_CAMERA.zoom,
        maxZoom: 8,
        maxPitch: 0,
        attributionControl: false,
        dragRotate: false,
      });
      map.touchZoomRotate.disableRotation();
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.on("zoom", () => {
        if (!rotationAllowedAtZoom(map.getZoom())) stopRotation();
      });
      map.on("zoomend", () => {
        if (rotationAllowedAtZoom(map.getZoom())) pauseRotation();
      });
      map.on("error", (event: MapEventType["error"]) => {
        if (event.error?.message.toLowerCase().includes("tile")) {
          root.classList.add("has-map-error");
          if (status) status.textContent = "Basemap unavailable. Place markers remain available.";
        } else {
          console.error("Atlas globe error", event.error);
        }
      });
      map.on("load", () => {
        map.setProjection({ type: "globe" });
        const nightHemisphereLayer = createNightHemisphereLayer(new Date());
        map.addLayer(nightHemisphereLayer);
        map.addSource("night-lights", { type: "geojson", data: nightLightsGeoJson([], new Date()) });
        map.addLayer({
          id: "night-lights-halo",
          type: "circle",
          source: "night-lights",
          paint: {
            "circle-color": "#ffd8a3",
            "circle-radius": ["interpolate", ["linear"], ["zoom"],
              1, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.25, 1, 1.15],
              3, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.35, 1, 1.63],
              5, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.75, 1, 3.6],
              6, ["interpolate", ["linear"], ["get", "intensity"], 0, 1.8, 1, 8.5],
              8, ["interpolate", ["linear"], ["get", "intensity"], 0, 6, 1, 27],
            ],
            "circle-opacity": ["interpolate", ["linear"], ["get", "intensity"], 0, 0.025, 1, 0.36],
            "circle-blur": 1,
          },
        });
        map.addLayer({
          id: "night-lights-core",
          type: "circle",
          source: "night-lights",
          paint: {
            "circle-color": "#ffe4b8",
            "circle-radius": ["interpolate", ["linear"], ["zoom"],
              1, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.12, 1, 0.58],
              3, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.18, 1, 0.84],
              5, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.32, 1, 1.65],
              6, ["interpolate", ["linear"], ["get", "intensity"], 0, 0.55, 1, 2.8],
              8, ["interpolate", ["linear"], ["get", "intensity"], 0, 1.4, 1, 7.2],
            ],
            "circle-opacity": ["interpolate", ["linear"], ["get", "intensity"], 0, 0.04, 1, 0.68],
            "circle-blur": 0.86,
          },
        });
        const updateEarthLighting = () => {
          const now = new Date();
          nightHemisphereLayer.setDate(now);
          (map.getSource("night-lights") as GeoJSONSource | undefined)?.setData(nightLightsGeoJson(nightLightPoints, now));
        };
        fetch("/data/night-lights.json")
          .then((response) => {
            if (!response.ok) throw new Error(`Night-light data returned ${response.status}`);
            return response.json() as Promise<{ points?: NightLightPoint[] }>;
          })
          .then((data) => {
            if (!Array.isArray(data.points)) throw new Error("Night-light data is invalid");
            nightLightPoints = data.points;
            updateEarthLighting();
          })
          .catch((error) => console.warn("Atlas night lights unavailable", error));
        window.setInterval(updateEarthLighting, 60_000);
        map.addSource("journey-route", { type: "geojson", data: journeyLineGeoJson(undefined, scopeMode) });
        map.addLayer({
          id: "journey-route",
          type: "line",
          source: "journey-route",
          layout: { "line-cap": "round", "line-join": "round" },
          paint: { "line-color": "#d5ddd8", "line-opacity": 0.76, "line-width": ["interpolate", ["linear"], ["zoom"], 1, 1.2, 6, 2.4] },
        });
        map.addSource("globe-places", {
          type: "geojson",
          data: pointGeoJson(points),
          ...PLACE_CLUSTER_OPTIONS,
          cluster: clusteringEnabled,
        });
        map.addLayer({
          id: "clusters",
          type: "circle",
          source: "globe-places",
          filter: ["has", "point_count"],
          paint: {
            "circle-color": "#101815",
            "circle-opacity": 0.9,
            "circle-radius": CLUSTER_RADIUS_EXPRESSION,
            "circle-stroke-color": "#d5ddd8",
            "circle-stroke-width": 1.25,
          },
        });
        map.addLayer({
          id: "cluster-count",
          type: "symbol",
          source: "globe-places",
          filter: ["has", "point_count"],
          layout: { "text-field": ["to-string", ["get", "point_count"]], "text-font": ["Open Sans Semibold"], "text-size": 12, "text-allow-overlap": true },
          paint: { "text-color": "#f1f4f1", "text-halo-color": "rgba(5, 6, 7, .94)", "text-halo-width": 0.7 },
        });
        map.addLayer({
          id: "unclustered-point",
          type: "circle",
          source: "globe-places",
          filter: ["!", ["has", "point_count"]],
          paint: { "circle-color": "#f1f4f1", "circle-radius": 2.75, "circle-stroke-color": "#050607", "circle-stroke-width": 2 },
        });
        map.addSource("journey-stops", { type: "geojson", data: journeyStopsGeoJson(undefined, scopeMode) });
        map.addLayer({
          id: "journey-stops",
          type: "circle",
          source: "journey-stops",
          paint: { "circle-color": "#050607", "circle-radius": 7, "circle-stroke-color": "#f1f4f1", "circle-stroke-width": 2 },
        });
        // Wishlist rides its own unclustered source: planned, not reached, so a
        // hollow violet ring — never mixed into globe-places (handoff §7.2).
        map.addSource("globe-wishlist", { type: "geojson", data: wishlistPointsGeoJson([], scopeMode) });
        map.addLayer({
          id: "wishlist-points",
          type: "circle",
          source: "globe-wishlist",
          paint: {
            "circle-radius": 2.75,
            "circle-opacity": 0,
            "circle-stroke-color": WISHLIST_POINT_COLOR,
            "circle-stroke-width": 2,
          },
        });

        map.on("click", "clusters", async (event: MapLayerMouseEvent) => {
          pauseRotation();
          const feature = event.features?.[0];
          const clusterId = feature?.properties?.cluster_id;
          if (typeof clusterId !== "number" || feature?.geometry.type !== "Point") return;
          const source = map.getSource("globe-places") as GeoJSONSource;
          try {
            const [zoom, leaves] = await Promise.all([
              source.getClusterExpansionZoom(clusterId),
              source.getClusterLeaves(clusterId, feature.properties?.point_count ?? 100, 0),
            ]);
            clusterResultIds = new Set(leaves.map((leaf) => String(leaf.properties?.id ?? "")));
            resultsExpanded = false;
            updateResults(filteredPoints());
            map.easeTo({ center: feature.geometry.coordinates as [number, number], zoom, duration: reducedMotion.matches ? 0 : 750 });
          } catch {
            // A filter can replace the source while cluster leaves are resolving.
          }
        });
        const selectFeature = (event: MapLayerMouseEvent) => {
          pauseRotation();
          const id = String(event.features?.[0]?.properties?.id ?? event.features?.[0]?.properties?.placeId ?? "");
          const point = pointById.get(id);
          if (point) showPlace(point);
        };
        map.on("click", "unclustered-point", selectFeature);
        map.on("click", "journey-stops", selectFeature);
        map.on("click", "wishlist-points", (event: MapLayerMouseEvent) => {
          pauseRotation();
          const feature = event.features?.[0];
          if (!feature || feature.geometry.type !== "Point") return;
          closePopup();
          if (selection) selection.hidden = true;
          const [longitude, latitude] = feature.geometry.coordinates;
          const content = document.createElement("div");
          const title = document.createElement("strong");
          const subtitle = document.createElement("span");
          title.textContent = String(feature.properties?.name ?? "");
          subtitle.textContent = String(feature.properties?.location ?? "");
          content.appendChild(title);
          content.appendChild(subtitle);
          popup = new maplibregl.Popup({ closeButton: false, offset: 14 })
            .setLngLat([longitude, latitude])
            .setDOMContent(content)
            .addTo(map);
        });
        for (const layer of ["clusters", "unclustered-point", "journey-stops", "wishlist-points"]) {
          map.on("mouseenter", layer, () => { map.getCanvas().style.cursor = "pointer"; });
          map.on("mouseleave", layer, () => { map.getCanvas().style.cursor = ""; });
        }
        if (status) status.textContent = `${points.length} visited places shown.`;
        // Apply the initial plan explicitly rather than relying on the default
        // visibility of freshly added layers.
        applyMapState(false);
        startRotation();
      });
    } catch {
      root.classList.add("has-map-error");
      if (status) status.textContent = "Interactive globe unavailable. Use the archive links below.";
      return;
    }

    // Each group writes only its own axis, so neither switch can reset the
    // other (§73/§74).
    scopeButtons.forEach((button) => button.addEventListener("click", () => {
      scopeMode = button.dataset.globeScope === "china" ? "china" : "world";
      applyMapState();
    }));
    viewButtons.forEach((button) => button.addEventListener("click", () => {
      viewMode = button.dataset.globeView === "footprint" ? "footprint" : "journey";
      applyMapState();
    }));
    clusterButton?.addEventListener("click", () => {
      clusteringEnabled = !clusteringEnabled;
      (map.getSource("globe-places") as GeoJSONSource | undefined)?.setClusterOptions({
        ...PLACE_CLUSTER_OPTIONS,
        cluster: clusteringEnabled,
      });
      applyMapState(false);
    });
    wishlistButton?.addEventListener("click", () => {
      wishlistEnabled = !wishlistEnabled;
      applyMapState(false);
    });
    yearSelect?.addEventListener("change", () => {
      selectedYear = yearSelect.value;
      applyMapState(false);
    });
    journeySelect?.addEventListener("change", () => {
      selectedJourney = journeySelect.value;
      applyMapState();
    });
    const beginInteraction = () => {
      stopRotation();
      window.clearTimeout(restartTimer);
    };
    canvas.addEventListener("pointerdown", beginInteraction, { passive: true });
    canvas.addEventListener("pointerup", () => pauseRotation(), { passive: true });
    canvas.addEventListener("pointercancel", () => pauseRotation(), { passive: true });
    canvas.addEventListener("wheel", () => pauseRotation(), { passive: true });
    canvas.addEventListener("keydown", () => pauseRotation());
    reducedMotion.addEventListener("change", () => reducedMotion.matches ? stopRotation() : startRotation());
    document.addEventListener("visibilitychange", () => document.hidden ? stopRotation() : startRotation());
    new IntersectionObserver(([entry]) => {
      mapVisible = entry.isIntersecting;
      if (mapVisible) startRotation();
      else stopRotation();
    }, { threshold: 0.08 }).observe(root);

    const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    if (!window.location.hash && navigation?.type === "navigate" && window.scrollY < 2) {
      window.requestAnimationFrame(() => {
        root.querySelector<HTMLElement>("[data-globe-entry]")?.scrollIntoView({ block: "start" });
      });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-prehome-globe]").forEach(initializeGlobe);
</script>
