---
import "maplibre-gl/dist/maplibre-gl.css";
import type { MapJourneyOption, MapPoint } from "../types/domain";
import { MAP_ATTRIBUTION } from "../lib/map/config";

interface Props {
  points: MapPoint[];
  years?: string[];
  journeys?: MapJourneyOption[];
  filters?: boolean;
  compact?: boolean;
}

const {
  points,
  years = [],
  journeys = [],
  filters = false,
  compact = false,
} = Astro.props;
const pointPayload = JSON.stringify(points).replaceAll("<", "\\u003c");
---

<section class:list={["interactive-map", { "interactive-map--compact": compact }]} data-atlas-map>
  <div class="section-heading">
    <div><p class="eyebrow">MAP / VISITED PLACES</p><h2>Coordinates</h2></div>
    <span data-map-count>{String(points.length).padStart(2, "0")} points</span>
  </div>
  {filters && points.length > 0 && (
    <form class="map-filters" data-map-filters>
      <button type="reset" class="is-active" data-map-all>All</button>
      <label><span>Year</span><select name="year" aria-label="Filter places by visit year"><option value="">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select></label>
      <label><span>Journey</span><select name="journey" aria-label="Filter places by journey"><option value="">All journeys</option>{journeys.map((journey) => <option value={journey.slug}>{journey.nameZh || journey.name}</option>)}</select></label>
    </form>
  )}
  {points.length ? (
    <div class="map-experience">
      <div class="map-stage">
        <div class="map-canvas" data-map-canvas role="region" aria-label="Interactive map of visited places"></div>
        <div class="map-attribution"><a href={MAP_ATTRIBUTION.href}>{MAP_ATTRIBUTION.label}</a><span> · </span><a href={MAP_ATTRIBUTION.libraryHref}>{MAP_ATTRIBUTION.libraryLabel}</a></div>
        <p class="map-runtime-status" data-map-status aria-live="polite">Interactive map loading; every place is also listed below.</p>
      </div>
      <noscript><p class="map-noscript">JavaScript is unavailable. Browse every mapped place in the list below.</p></noscript>
      <aside class="map-selection" data-map-selection hidden aria-live="polite">
        <p class="eyebrow">SELECTED PLACE</p>
        <h3 data-map-selection-name></h3>
        <p data-map-selection-location></p>
        <p><span data-map-selection-visits></span> · Last visited <time data-map-selection-date></time></p>
        <a data-map-selection-link>View place ↗</a>
      </aside>
      <ol class="map-place-list" data-map-list>
        {points.map((point, index) => (
          <li data-map-point={point.id}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><button type="button" data-map-select={point.id}>{point.name}</button>{point.name !== point.nameEn && <small>{point.nameEn}</small>}</div>
            <p>{point.location}</p>
            <time datetime={point.lastVisitedAt}>{point.lastVisitedAt}</time>
            <a href={point.href} aria-label={`View ${point.name}`}>↗</a>
          </li>
        ))}
      </ol>
      <p class="map-no-results" data-map-empty hidden>No places match these filters.</p>
    </div>
  ) : (
    <div class="map-empty"><p>No visited places yet.</p><span>Coordinates will appear after the first visit is recorded.</span></div>
  )}
  <script type="application/json" data-map-payload set:html={pointPayload} is:inline />
</section>

<script>
  import * as maplibregl from "maplibre-gl";
  import type { GeoJSONSource, MapEventType, MapGeoJSONFeature, MapLayerMouseEvent } from "maplibre-gl";
  import { CLUSTER_RADIUS_EXPRESSION, MAP_STYLE, PLACE_CLUSTER_OPTIONS } from "../lib/map/config";
  import { filterMapPoints } from "../lib/map/points";
  import type { MapPoint } from "../types/domain";

  function initializeArchiveMap(root: HTMLElement) {
    if (root.dataset.enhanced) return;
    root.dataset.enhanced = "true";
    const payload = root.querySelector<HTMLScriptElement>("[data-map-payload]");
    const canvas = root.querySelector<HTMLElement>("[data-map-canvas]");
    if (!payload || !canvas) return;

    let points: MapPoint[] = [];
    try {
      points = JSON.parse(payload.textContent || "[]") as MapPoint[];
    } catch {
      root.querySelector<HTMLElement>("[data-map-status]")!.textContent = "Map data unavailable. Browse the place list below.";
      return;
    }

    const status = root.querySelector<HTMLElement>("[data-map-status]");
    const count = root.querySelector<HTMLElement>("[data-map-count]");
    const empty = root.querySelector<HTMLElement>("[data-map-empty]");
    const selection = root.querySelector<HTMLElement>("[data-map-selection]");
    const listItems = new Map(
      [...root.querySelectorAll<HTMLElement>("[data-map-point]")].map((item) => [item.dataset.mapPoint!, item]),
    );
    const pointById = new Map(points.map((point) => [point.id, point]));
    let map: maplibregl.Map | null = null;
    let visiblePoints = filterMapPoints(points, {});
    let selectedPopup: maplibregl.Popup | null = null;
    let hoveredClusterId: string | number | null = null;
    let hoveredPointId: string | number | null = null;
    let selectedId = "";

    const asGeoJson = (items: MapPoint[]) => ({
      type: "FeatureCollection" as const,
      features: items.map((point) => ({
        type: "Feature" as const,
        id: point.id,
        properties: { id: point.id },
        geometry: {
          type: "Point" as const,
          coordinates: [point.longitude, point.latitude],
        },
      })),
    });

    const closePopup = () => {
      selectedPopup?.remove();
      selectedPopup = null;
    };

    const showPointPopup = (point: MapPoint) => {
      if (!map) return;
      closePopup();
      const tooltip = document.createElement("div");
      const title = document.createElement("strong");
      const summary = document.createElement("span");
      title.textContent = point.name;
      summary.textContent = `${point.visitCount} ${point.visitCount === 1 ? "visit" : "visits"} · ${point.lastVisitedAt}`;
      tooltip.appendChild(title);
      tooltip.appendChild(summary);
      selectedPopup = new maplibregl.Popup({ closeButton: false, offset: 14 })
        .setLngLat([point.longitude, point.latitude])
        .setDOMContent(tooltip)
        .addTo(map);
    };

    const showSelection = (point: MapPoint, focusMap = false) => {
      selectedId = point.id;
      if (selection) {
        selection.hidden = false;
        selection.querySelector<HTMLElement>("[data-map-selection-name]")!.textContent = point.name;
        selection.querySelector<HTMLElement>("[data-map-selection-location]")!.textContent = point.location;
        selection.querySelector<HTMLElement>("[data-map-selection-visits]")!.textContent = `${point.visitCount} ${point.visitCount === 1 ? "visit" : "visits"}`;
        const date = selection.querySelector<HTMLTimeElement>("[data-map-selection-date]")!;
        date.dateTime = point.lastVisitedAt;
        date.textContent = point.lastVisitedAt;
        const link = selection.querySelector<HTMLAnchorElement>("[data-map-selection-link]")!;
        link.href = point.href;
      }
      listItems.forEach((item, id) => {
        if (id === point.id) item.setAttribute("aria-current", "true");
        else item.removeAttribute("aria-current");
      });
      if (map && focusMap) {
        map.easeTo({
          center: [point.longitude, point.latitude],
          zoom: Math.max(map.getZoom(), PLACE_CLUSTER_OPTIONS.clusterMaxZoom + 1),
          duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 650,
        });
        showPointPopup(point);
      }
    };

    root.querySelectorAll<HTMLButtonElement>("[data-map-select]").forEach((button) => {
      button.addEventListener("click", () => {
        const point = pointById.get(button.dataset.mapSelect ?? "");
        if (point) showSelection(point, true);
      });
    });

    try {
      map = new maplibregl.Map({
        container: canvas,
        style: MAP_STYLE,
        center: [0, 20],
        zoom: 1,
        attributionControl: false,
      });
      map.scrollZoom.disable();
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.on("error", (event: MapEventType["error"]) => {
        if (event.error?.message.toLowerCase().includes("tile")) {
          root.classList.add("has-map-error");
          if (status) status.textContent = "Basemap unavailable. Points and the place list remain available.";
        } else {
          console.error("Atlas map error", event.error);
        }
      });
      map.on("load", () => {
        if (!map) return;
        map.addSource("places", {
          type: "geojson",
          data: asGeoJson(visiblePoints),
          ...PLACE_CLUSTER_OPTIONS,
        });

        map.addLayer({
          id: "clusters",
          type: "circle",
          source: "places",
          filter: ["has", "point_count"],
          paint: {
            "circle-color": "#dce2dc",
            "circle-opacity": 0.94,
            "circle-radius": ["*", CLUSTER_RADIUS_EXPRESSION, ["case", ["boolean", ["feature-state", "hover"], false], 1.08, 1]],
            "circle-stroke-color": "#52635c",
            "circle-stroke-width": 1.25,
          },
        });

        map.addLayer({
          id: "cluster-count",
          type: "symbol",
          source: "places",
          filter: ["has", "point_count"],
          layout: {
            "text-field": ["to-string", ["get", "point_count"]],
            "text-font": ["Open Sans Semibold"],
            "text-size": 12,
            "text-allow-overlap": true,
          },
          paint: {
            "text-color": "#23362f",
            "text-halo-color": "rgba(243, 244, 239, 0.92)",
            "text-halo-width": 0.6,
          },
        });

        map.addLayer({
          id: "unclustered-point",
          type: "circle",
          source: "places",
          filter: ["!", ["has", "point_count"]],
          paint: {
            "circle-color": "#23362f",
            "circle-radius": ["case", ["boolean", ["feature-state", "hover"], false], 7, 5.5],
            "circle-stroke-color": "#f3f4ef",
            "circle-stroke-width": 2,
          },
        });

        map.on("click", "clusters", async (event: MapLayerMouseEvent) => {
          const feature = event.features?.[0];
          const clusterId = feature?.properties?.cluster_id;
          if (!map || !feature || typeof clusterId !== "number" || feature.geometry.type !== "Point") return;
          try {
            const zoom = await (map.getSource("places") as GeoJSONSource).getClusterExpansionZoom(clusterId);
            map.easeTo({
              center: feature.geometry.coordinates as [number, number],
              zoom,
              duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 700,
            });
          } catch {
            // The source can change while a filter is applied; stale cluster ids are safe to ignore.
          }
        });

        map.on("click", "unclustered-point", (event: MapLayerMouseEvent) => {
          const point = pointById.get(String(event.features?.[0]?.properties?.id ?? ""));
          if (point) {
            showSelection(point);
            showPointPopup(point);
          }
        });

        const setHover = (feature: MapGeoJSONFeature | undefined, hover: boolean) => {
          if (!map || feature?.id === undefined) return;
          map.setFeatureState({ source: "places", id: feature.id }, { hover });
        };
        map.on("mousemove", "clusters", (event: MapLayerMouseEvent) => {
          const feature = event.features?.[0];
          if (hoveredClusterId !== null) map?.setFeatureState({ source: "places", id: hoveredClusterId }, { hover: false });
          hoveredClusterId = feature?.id ?? null;
          setHover(feature, true);
          map!.getCanvas().style.cursor = "pointer";
        });
        map.on("mouseleave", "clusters", () => {
          if (hoveredClusterId !== null) map?.setFeatureState({ source: "places", id: hoveredClusterId }, { hover: false });
          hoveredClusterId = null;
          if (map) map.getCanvas().style.cursor = "";
        });
        map.on("mouseenter", "unclustered-point", (event: MapLayerMouseEvent) => {
          const feature = event.features?.[0];
          hoveredPointId = feature?.id ?? null;
          setHover(feature, true);
          map!.getCanvas().style.cursor = "pointer";
        });
        map.on("mouseleave", "unclustered-point", () => {
          if (hoveredPointId !== null) map?.setFeatureState({ source: "places", id: hoveredPointId }, { hover: false });
          hoveredPointId = null;
          if (map) map.getCanvas().style.cursor = "";
        });

        fitVisiblePoints(visiblePoints);
        if (status) status.textContent = "Map ready. Select a point or use the synchronized place list.";
      });
    } catch {
      root.classList.add("has-map-error");
      if (status) status.textContent = "Interactive map unavailable. Browse and open every place from the list below.";
    }

    const fitVisiblePoints = (visible: MapPoint[]) => {
      if (!map || visible.length === 0) return;
      if (visible.length === 1) map.jumpTo({ center: [visible[0].longitude, visible[0].latitude], zoom: 10 });
      else {
        const bounds = new maplibregl.LngLatBounds();
        visible.forEach(({ latitude, longitude }) => bounds.extend([longitude, latitude]));
        map.fitBounds(bounds, { padding: 32, maxZoom: 10, duration: 0 });
      }
    };

    const applyFilters = () => {
      const form = root.querySelector<HTMLFormElement>("[data-map-filters]");
      const values = form ? new FormData(form) : null;
      visiblePoints = filterMapPoints(points, {
        year: values?.get("year")?.toString() || undefined,
        journey: values?.get("journey")?.toString() || undefined,
      });
      const visibleIds = new Set(visiblePoints.map(({ id }) => id));
      listItems.forEach((item, id) => { item.hidden = !visibleIds.has(id); });
      const source = map?.getSource("places") as GeoJSONSource | undefined;
      source?.setData(asGeoJson(visiblePoints));
      if (selectedId && !visibleIds.has(selectedId) && selection) {
        selectedId = "";
        selection.hidden = true;
        closePopup();
      }
      if (empty) empty.hidden = visiblePoints.length > 0;
      if (count) count.textContent = `${String(visiblePoints.length).padStart(2, "0")} points`;
      const all = root.querySelector<HTMLElement>("[data-map-all]");
      all?.classList.toggle("is-active", !values?.get("year") && !values?.get("journey"));
      if (source) fitVisiblePoints(visiblePoints);
    };

    const filters = root.querySelector<HTMLFormElement>("[data-map-filters]");
    filters?.addEventListener("change", applyFilters);
    filters?.addEventListener("reset", () => window.setTimeout(applyFilters));
    applyFilters();
  }

  document.querySelectorAll<HTMLElement>("[data-atlas-map]").forEach(initializeArchiveMap);
</script>
