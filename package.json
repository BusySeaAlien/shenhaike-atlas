{
  "name": "shenhaike-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "wrangler types && astro dev --host 127.0.0.1",
    "check": "wrangler types && astro check",
    "build": "wrangler types && astro build",
    "test": "vitest run",
    "test:database": "node scripts/verify-database.mjs",
    "verify": "pnpm test && pnpm test:database && pnpm check && pnpm build",
    "preview": "wrangler types && astro preview --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:query:local": "wrangler d1 execute DB --local --command",
    "db:query:production": "wrangler d1 execute DB --remote --command",
    "data:night-lights": "node scripts/generate-night-lights.mjs",
    "data:china-boundary": "node scripts/generate-china-boundary.mjs",
    "data:china-administrative": "node scripts/generate-china-administrative.mjs",
    "data:world-administrative": "node scripts/generate-world-administrative.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "astro": "7.3.2",
    "jose": "6.2.12",
    "maplibre-gl": "5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.0",
    "mapshaper": "^0.7.61",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
